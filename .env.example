# WISE Foundation — backend environment variables (copy to .env for local runs,
# and set the same keys in the Render dashboard under wisef-rag-api → Environment)

# --- Gemini (RAG chat) ---
# Required for AI chat answers. Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# --- SMTP (contact form → info@wisef.am) ---
# Without these, contact submissions are only logged to backend/data/contact_messages.jsonl
SMTP_HOST=mail.wisef.am
SMTP_PORT=587
SMTP_USER=info@wisef.am
SMTP_PASSWORD=
# Optional: sender shown in the From header (defaults to SMTP_USER)
SMTP_FROM=
# Recipient of contact form submissions (default info@wisef.am)
CONTACT_TO_EMAIL=info@wisef.am

# --- Optional webhook (Slack / email service) instead of SMTP ---
CONTACT_WEBHOOK_URL=

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Rate limiting ---
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SEC=60

# --- Re-ingest scheduler ---
REINGEST_INTERVAL_HOURS=0
REINGEST_MODE=off

# --- Trust proxy (Render) ---
TRUST_PROXY_HOPS=1
