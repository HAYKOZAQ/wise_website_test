<!DOCTYPE html>
<html lang="{{ lang | default('hy') }}">
<head>
  <script>try{var t=localStorage.getItem('wisef_theme')||'light';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='dark'?'dark':'light');}catch(e){}</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0d233a">
  <title{% if title_key %} data-i18n="{{ title_key }}"{% endif %}>{{ title | default('WISE Foundation') }}</title>
  <meta name="description" content="{{ description | default('Welfare Information Systems Enterprise Foundation — Leading technology center in Armenia.') }}"{% if desc_key %} data-i18n="{{ desc_key }}" data-i18n-attr="content"{% endif %}>
  <link rel="canonical" href="https://wisef.am{{ page.url or permalink or '/' }}">
  
  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WISE Foundation">
  <meta property="og:url" content="https://wisef.am{{ page.url or permalink or '/' }}">
  <meta property="og:locale" content="{{ 'hy_AM' if (lang == 'hy' or not lang) else ('ru_RU' if lang == 'ru' else 'en_US') }}">
  <meta property="og:title" content="{{ title | default('WISE Foundation') }}"{% if title_key %} data-i18n="{{ title_key }}" data-i18n-attr="content"{% endif %}>
  <meta property="og:description" content="{{ description | default('Welfare Information Systems Enterprise Foundation — Leading technology center in Armenia.') }}"{% if desc_key %} data-i18n="{{ desc_key }}" data-i18n-attr="content"{% endif %}>
  <meta property="og:image" content="https://wisef.am/assets/logos/wisef-logo.svg">
  <meta property="og:image:alt" content="WISE Foundation Logo">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://wisef.am{{ page.url or permalink or '/' }}">
  <meta name="twitter:title" content="{{ title | default('WISE Foundation') }}"{% if title_key %} data-i18n="{{ title_key }}" data-i18n-attr="content"{% endif %}>
  <meta name="twitter:description" content="{{ description | default('Welfare Information Systems Enterprise Foundation — Leading technology center in Armenia.') }}"{% if desc_key %} data-i18n="{{ desc_key }}" data-i18n-attr="content"{% endif %}>
  <meta name="twitter:image" content="https://wisef.am/assets/logos/wisef-logo.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css?v=49">
  <link rel="stylesheet" href="/css/glass.css?v=49">
  <link rel="stylesheet" href="/css/components.css?v=49">
  <link rel="stylesheet" href="/css/dark.css?v=49">
  <link rel="stylesheet" href="/css/presentation.css?v=63">
  <link rel="stylesheet" href="/css/animations.css?v=6">
  <link rel="icon" href="/assets/logos/favicon.svg" type="image/svg+xml">
</head>
<body lang="{{ lang | default('hy') }}">
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script src="/js/main.js?v=54" defer></script>
<script src="/js/vendor/purify.min.js?v=49" defer></script>
<script src="/js/i18n.js?v=59" defer></script>
<script src="/js/config.js?v=49" defer></script>
<script src="/js/chat.js?v=51" defer></script>
<script src="/js/animations.js?v=3" defer></script>
<script src="/js/blog.js?v=53" defer></script>
</body>
</html>
