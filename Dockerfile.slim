# WISE website + RAG API — slim runtime for 512 MB free tiers (Render)
# Assumes the compact BM25 index and corpus are pre-built and committed.
# No torch / sentence-transformers / tensorflow / FAISS at runtime.
FROM node:20-alpine AS frontend
WORKDIR /web

COPY package.json package-lock.json ./
RUN npm ci

COPY .eleventy.js ./
COPY src/ ./src/
COPY scripts/ ./scripts/
RUN npm run build


FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements-slim.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

ARG CACHEBUST=47
ARG BUILD_SHA=dev
ARG BUILD_TIME=unknown

# Runtime Python modules only. Source PDFs, ingestion caches, seed snapshots,
# and per-document corpus files are intentionally not copied into this image.
COPY backend/*.py /app/
COPY backend/start.sh /app/start.sh
COPY backend/data/mlsa_programs.json /app/data/mlsa_programs.json
COPY backend/data/index/chunks.json /app/data/index/chunks.json
COPY backend/data/index/bm25.npz /app/data/index/bm25.npz
COPY backend/data/index/bm25_vocab.json /app/data/index/bm25_vocab.json
COPY backend/data/index/corpus_hash.txt /app/data/index/corpus_hash.txt

# Built frontend static site (Eleventy output)
COPY --from=frontend /web/_site/ /app/frontend/

# Verify the compact lexical index is present
RUN test -f /app/data/index/bm25.npz \
    && test -f /app/data/index/bm25_vocab.json \
    && test -f /app/data/index/chunks.json \
    && test -f /app/data/index/corpus_hash.txt \
    && echo "Pre-built index verified OK"

# Verify frontend assets
RUN test -f /app/frontend/css/base.css \
    && test -f /app/frontend/css/glass.css \
    && test -f /app/frontend/css/components.css \
    && test -f /app/frontend/css/dark.css \
    && test -f /app/frontend/css/animations.css \
    && test -f /app/frontend/js/main.js \
    && test -f /app/frontend/js/i18n.js \
    && test -f /app/frontend/js/chat.js \
    && test -f /app/frontend/js/config.js \
    && test -f /app/frontend/js/animations.js \
    && test -f /app/frontend/js/blog.js \
    && test -f /app/frontend/index.html \
    && test -f /app/frontend/about.html \
    && test -f /app/frontend/services.html \
    && test -f /app/frontend/partners.html \
    && test -f /app/frontend/contact.html \
    && test -f /app/frontend/blog.html \
    && test -f /app/frontend/en/index.html \
    && test -f /app/frontend/en/about.html \
    && test -f /app/frontend/en/services.html \
    && test -f /app/frontend/en/partners.html \
    && test -f /app/frontend/en/contact.html \
    && test -f /app/frontend/en/blog.html \
    && test -f /app/frontend/assets/videos/hero.mp4 \
    && test -f /app/frontend/assets/images/partners/HH_Gerb.svg \
    && test -f /app/frontend/assets/images/partners/usaid.svg \
    && test -f /app/frontend/assets/images/partners/microsoft.svg \
    && test -f /app/frontend/assets/images/partners/p22.svg \
    && test -f /app/frontend/assets/images/partners/pek.jpg \
    && echo "Frontend assets verified OK"

# Deploy stamp
RUN printf '{\n  "service": "wisef",\n  "frontend": "/app/frontend",\n  "build_sha": "%s",\n  "build_time": "%s",\n  "asset_version": "%s"\n}\n' "$BUILD_SHA" "$BUILD_TIME" "$CACHEBUST" > /app/version.json \
    && echo "cachebust=$CACHEBUST" > /app/frontend/.deploy-stamp \
    && test -f /app/start.sh

ENV HOST=0.0.0.0
ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV USE_LOCAL_EMBEDDER=0
ENV USE_LOCAL_TFIDF=0

EXPOSE 8000

RUN chmod +x /app/start.sh
CMD ["/app/start.sh"]
